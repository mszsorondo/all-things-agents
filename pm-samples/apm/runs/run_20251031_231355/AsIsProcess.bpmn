<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.signavio.com/bpmn20" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath">
  <bpmn:process id="AsIsProcess" isClosed="false" isExecutable="false">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>flow_HandInJobApplication</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_HandInJobApplication" name="Hand In Job Application">
      <bpmn:incoming>flow_HandInJobApplication</bpmn:incoming>
      <bpmn:outgoing>flow_TelephonicScreening</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TelephonicScreening" name="Telephonic Screening">
      <bpmn:incoming>flow_TelephonicScreening</bpmn:incoming>
      <bpmn:outgoing>flow_BackgroundCheck</bpmn:outgoing>
      <bpmn:outgoing>flow_ScreeningInterview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BackgroundCheck" name="Background Check">
      <bpmn:incoming>flow_BackgroundCheck</bpmn:incoming>
      <bpmn:outgoing>flow_ScreeningInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_CodingInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_ApplicationRejected</bpmn:outgoing>
      <bpmn:outgoing>flow_ExtensiveBackgroundCheck</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ScreeningInterview" name="Screening Interview">
      <bpmn:incoming>flow_ScreeningInterview</bpmn:incoming>
      <bpmn:outgoing>flow_CodingInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_ApplicationRejected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CodingInterview" name="Coding Interview">
      <bpmn:incoming>flow_CodingInterview</bpmn:incoming>
      <bpmn:outgoing>flow_FrontendInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_MLInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_ApplicationRejected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FrontendInterview" name="Frontend Interview">
      <bpmn:incoming>flow_FrontendInterview</bpmn:incoming>
      <bpmn:outgoing>flow_BehavioralInterview</bpmn:outgoing>
      <bpmn:outgoing>flow_ApplicationRejected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BehavioralInterview" name="Behavioral Interview">
      <bpmn:incoming>flow_BehavioralInterview</bpmn:incoming>
      <bpmn:outgoing>flow_MakeJobOffer</bpmn:outgoing>
      <bpmn:outgoing>flow_ApplicationRejected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MakeJobOffer" name="Make Job Offer">
      <bpmn:incoming>flow_MakeJobOffer</bpmn:incoming>
      <bpmn:outgoing>flow_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent" name="End">
      <bpmn:incoming>flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_HandInJobApplication" sourceRef="StartEvent" targetRef="Task_HandInJobApplication" />
    <bpmn:sequenceFlow id="flow_TelephonicScreening" sourceRef="Task_HandInJobApplication" targetRef="Task_TelephonicScreening" />
    <bpmn:sequenceFlow id="flow_BackgroundCheck" sourceRef="Task_TelephonicScreening" targetRef="Task_BackgroundCheck" />
    <bpmn:sequenceFlow id="flow_ScreeningInterview" sourceRef="Task_TelephonicScreening" targetRef="Task_ScreeningInterview" />
    <bpmn:sequenceFlow id="flow_CodingInterview" sourceRef="Task_ScreeningInterview" targetRef="Task_CodingInterview" />
    <bpmn:sequenceFlow id="flow_FrontendInterview" sourceRef="Task_CodingInterview" targetRef="Task_FrontendInterview" />
    <bpmn:sequenceFlow id="flow_MakeJobOffer" sourceRef="Task_BehavioralInterview" targetRef="Task_MakeJobOffer" />
    <bpmn:sequenceFlow id="flow_End" sourceRef="Task_MakeJobOffer" targetRef="EndEvent" />
    <bpmn:sequenceFlow id="flow_ApplicationRejected" sourceRef="Task_BackgroundCheck" targetRef="EndEvent" />
    <bpmn:sequenceFlow id="flow_ExtensiveBackgroundCheck" sourceRef="Task_BackgroundCheck" targetRef="Task_CodingInterview" />
    <bpmn:sequenceFlow id="flow_ApplicationRejected" sourceRef="Task_TelephonicScreening" targetRef="EndEvent" />
    <bpmn:sequenceFlow id="flow_ApplicationRejected" sourceRef="Task_ScreeningInterview" targetRef="EndEvent" />
	</bpmn:process>

</bpmn:definitions>